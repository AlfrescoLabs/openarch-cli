# Generated by openarch. OpenArch reads this file at startup.
# 'openarch render' writes it again, so changes made here are lost.
# The admin password is in .env.local. This file holds only its bcrypt hash.
administratorsGroups:
  - administrators

groups:
  - id: "5324ec90-ba1e-4030-8e6a-d815c6f3d4b1"
    name: administrators
  - id: "8d6542c9-50e9-4027-aa10-2cfb2179413f"
    name: members

users:
  - id: "00000000-0000-0000-0000-000000000001"
    username: {{ quote .AdminUser }}
    password: {{ quote (print "{bcrypt}" .AdminHash) }}
    firstName: Admin
    lastName: User
    email: admin@example.com
    groups:
      - administrators
      - members
