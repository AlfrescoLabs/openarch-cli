# Generated by openarch. OpenSearch reads this file only when its data is created.
# The passwords are in .env.local. This file holds only their bcrypt hashes.
_meta:
  type: "internalusers"
  config_version: 2

{{ .OpenSearchAdminUser }}:
  hash: {{ quote .OpenSearchHashes.Admin }}
  reserved: true
  description: "OpenSearch administrator"

{{ .OpenSearchAppUser }}:
  hash: {{ quote .OpenSearchHashes.App }}
  reserved: true
  description: "OpenArch application"

{{ .DashboardsUser }}:
  hash: {{ quote .OpenSearchHashes.Dashboards }}
  reserved: true
  description: "OpenSearch Dashboards server"
