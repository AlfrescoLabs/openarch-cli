# Generated by openarch from openarch.yaml. Do not edit this file:
# change openarch.yaml and run 'openarch render' instead.
# Values such as ${OPENARCH_PORT} come from .env.
{{- if .Secure }}
# Secrets come from .env.local. Run: docker compose --env-file .env --env-file .env.local up -d
# Containers read them as files in /run/secrets, never as environment variables.
{{- end }}
name: {{ .Config.Name }}

services:
  openarch-app:
    image: ghcr.io/hyland/openarch-app-jvm:${OPENARCH_VERSION:?set OPENARCH_VERSION in .env}
    restart: unless-stopped
    # 'openarch up' sets this hash of the users file and secrets, so a change recreates the container.
    labels:
      openarch.config-hash: ${OPENARCH_APP_CONFIG_HASH:-}
    depends_on:
{{- if .Bind }}
      data-init:
        condition: service_completed_successfully
{{- end }}
      mongodb-init:
        condition: service_completed_successfully
      opensearch:
        condition: service_healthy
{{- if .Secure }}
    # Reads the connection secrets into the OpenArch process only.
    entrypoint:
      - /bin/sh
      - -c
      - |-
        NUXEO_MONGODB_SERVER="$$(cat /run/secrets/mongodb_app_uri)" || exit 1
        OPENSEARCH_RESTCLIENT_PASSWORD="$$(cat /run/secrets/opensearch_app_password)" || exit 1
        export NUXEO_MONGODB_SERVER OPENSEARCH_RESTCLIENT_PASSWORD
        exec /bin/sh /deployments/run-java.sh
{{- end }}
    environment:
      OPENSEARCH_ADDRESSLIST: http://opensearch:9200
{{- if .Secure }}
      OPENSEARCH_RESTCLIENT_USERNAME: {{ .OpenSearchAppUser }}
{{- else }}
      NUXEO_MONGODB_SERVER: mongo:27017
{{- end }}
      NUXEO_MONGODB_DBNAME: {{ .MongoAppDB }}
      NUXEO_URL: {{ quote .Config.URL }}
{{- if not .Config.Security.DefaultUsers }}
      OPENARCH_USERS_FILE: file:/etc/openarch/users.yml
{{- end }}
      JAVA_OPTIONS: -Daws.crt.libc=musl -Xmx${OPENARCH_HEAP:?set OPENARCH_HEAP in .env}
{{- if .Config.Has "debug" }}
      JAVA_ENABLE_DEBUG: "true"
{{- end }}
{{- if .Config.TLSEnabled }}
      SERVER_FORWARD_HEADERS_STRATEGY: framework
{{- end }}
{{- if .Secure }}
    secrets:
      - mongodb_app_uri
      - opensearch_app_password
{{- end }}
{{- if or (not .Config.Security.DefaultUsers) .Volume .Bind }}
    volumes:
{{- if not .Config.Security.DefaultUsers }}
      - ./config/users.yml:/etc/openarch/users.yml:ro
{{- end }}
{{- if .Volume }}
      - openarch-data:/deployments/nxserver/data
{{- else if .Bind }}
      - {{ mount .DataDir "openarch" "/deployments/nxserver/data" }}
{{- end }}
{{- end }}
{{- if or (not .Config.TLSEnabled) (.Config.Has "debug") }}
    ports:
{{- if not .Config.TLSEnabled }}
      - "${OPENARCH_BIND_IP:?}:${OPENARCH_PORT:?}:8080"
{{- end }}
{{- if .Config.Has "debug" }}
      - "${OPENARCH_BIND_IP:?}:5005:5005"
{{- end }}
{{- end }}
    healthcheck:
      test: ["CMD", "busybox", "wget", "-q", "-O", "/dev/null", "http://localhost:8080/actuator/health/readiness"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 180s

  # OpenArch needs a MongoDB replica set (sessions and transactions), even with one node.
  # The replica set advertises mongo:27017.
  mongodb:
    image: {{ .Images.MongoDB }}
    hostname: mongo
    restart: unless-stopped
    labels:
      openarch.config-hash: ${OPENARCH_MONGODB_CONFIG_HASH:-}
{{- if .Secure }}
    # A replica set with authentication needs a key file. With one node, a new
    # random key at each start is enough.
    entrypoint:
      - /bin/sh
      - -c
      - |-
        head -c 756 /dev/urandom | base64 -w 0 > /tmp/mongodb-keyfile &&
        chmod 400 /tmp/mongodb-keyfile && chown 999:999 /tmp/mongodb-keyfile &&
        exec docker-entrypoint.sh mongod --replSet rs0 --bind_ip_all --keyFile /tmp/mongodb-keyfile --wiredTigerCacheSizeGB "$$MONGODB_CACHE_GB"
    environment:
      MONGODB_CACHE_GB: ${MONGODB_CACHE_GB:?set MONGODB_CACHE_GB in .env}
      # The root user is created only when the data folder is empty.
      MONGO_INITDB_ROOT_USERNAME: {{ .MongoRootUser }}
      MONGO_INITDB_ROOT_PASSWORD_FILE: /run/secrets/mongodb_root_password
    secrets:
      - mongodb_root_password
{{- else }}
    command: ["mongod", "--replSet", "rs0", "--bind_ip_all", "--wiredTigerCacheSizeGB", "${MONGODB_CACHE_GB:?set MONGODB_CACHE_GB in .env}"]
{{- end }}
    networks:
      default:
        aliases:
          - mongo
{{- if .Volume }}
    volumes:
      - mongodb-data:/data/db
{{- else if .Bind }}
    volumes:
      - {{ mount .DataDir "mongodb" "/data/db" }}
{{- end }}
{{- if .Config.Has "mongodb" }}
    ports:
      - "${OPENARCH_BIND_IP:?}:27017:27017"
{{- end }}

{{- if .Secure }}

  # Starts the replica set and creates or updates the OpenArch database user.
  mongodb-init:
    image: {{ .Images.MongoDB }}
    restart: "no"
    labels:
      openarch.config-hash: ${OPENARCH_MONGODB_CONFIG_HASH:-}
    depends_on:
      - mongodb
    secrets:
      - mongodb_root_password
      - mongodb_app_password
    command:
      - mongosh
      - --nodb
      - --quiet
      - --eval
      - |-
        const fs = require("fs");
        const secret = (name) => fs.readFileSync("/run/secrets/" + name, "utf8").trim();
        const url = "mongodb://{{ .MongoRootUser }}:" + encodeURIComponent(secret("mongodb_root_password")) + "@mongo:27017/admin?directConnection=true";
        let conn;
        for (let i = 0; i < 90 && !conn; i++) {
          try { conn = new Mongo(url); } catch (e) { sleep(1000); }
        }
        if (!conn) { print("MongoDB not reachable after 90s"); quit(1); }
        const admin = conn.getDB("admin");
        try { admin.adminCommand({ replSetGetStatus: 1 }); } catch (e) {
          if (e.codeName !== "NotYetInitialized") { throw e; }
          admin.adminCommand({ replSetInitiate: { _id: "rs0", members: [{ _id: 0, host: "mongo:27017" }] } });
        }
        for (let i = 0; i < 60 && !admin.adminCommand({ hello: 1 }).isWritablePrimary; i++) { sleep(1000); }
        const db = conn.getDB("{{ .MongoAppDB }}");
        const pwd = secret("mongodb_app_password");
        if (db.getUser("{{ .MongoAppUser }}")) {
          db.updateUser("{{ .MongoAppUser }}", { pwd: pwd });
        } else {
          db.createUser({ user: "{{ .MongoAppUser }}", pwd: pwd, roles: [{ role: "readWrite", db: "{{ .MongoAppDB }}" }] });
        }
        print("MongoDB ready");
{{- else }}

  mongodb-init:
    image: {{ .Images.MongoDB }}
    restart: "no"
    depends_on:
      - mongodb
    command:
      - /bin/sh
      - -c
      - |-
        for i in $$(seq 60); do
          mongosh --host mongo:27017 --quiet --eval 'db.runCommand({ping:1}).ok' | grep -q 1 && break
          sleep 1
        done
        mongosh --host mongo:27017 --quiet --eval 'db.runCommand({ping:1}).ok' | grep -q 1 ||
        { echo "MongoDB not reachable after 60s"; exit 1; }
        mongosh --host mongo:27017 --quiet --eval 'try { rs.status().ok; } catch (error) { rs.initiate({_id: "rs0", members: [{_id: 0, host: "mongo:27017"}]}); }'
{{- end }}

  opensearch:
    image: {{ .Images.OpenSearch }}
    restart: unless-stopped
    labels:
      openarch.config-hash: ${OPENARCH_OPENSEARCH_CONFIG_HASH:-}
{{- if .Bind }}
    depends_on:
      data-init:
        condition: service_completed_successfully
{{- end }}
{{- if .Secure }}
    # The security plugin needs TLS between nodes. This creates a node
    # certificate inside the container at each start. HTTP on port 9200 is plain.
    entrypoint:
      - /bin/bash
      - -c
      - |-
        set -e
        d=/usr/share/opensearch/config/transport
        rm -rf "$$d" && mkdir -p "$$d"
        TRANSPORT_STORE_PASSWORD="$$(head -c 24 /dev/urandom | base64 | tr -d '/+=')"
        export TRANSPORT_STORE_PASSWORD
        keytool -genkeypair -alias node -keyalg RSA -keysize 2048 -validity 3650 \
          -dname CN=opensearch-node -ext SAN=dns:opensearch,dns:localhost \
          -keystore "$$d/node.p12" -storetype PKCS12 -storepass "$$TRANSPORT_STORE_PASSWORD" -noprompt
        keytool -exportcert -alias node -rfc -keystore "$$d/node.p12" -storepass "$$TRANSPORT_STORE_PASSWORD" -file "$$d/node.pem"
        keytool -importcert -alias node -file "$$d/node.pem" -keystore "$$d/trust.p12" \
          -storetype PKCS12 -storepass "$$TRANSPORT_STORE_PASSWORD" -noprompt
        exec ./opensearch-docker-entrypoint.sh opensearch
{{- end }}
    environment:
      discovery.type: single-node
      cluster.routing.allocation.disk.threshold_enabled: "false"
      bootstrap.memory_lock: "true"
      # 'openarch backup' writes snapshots here, inside the container, then copies them out.
      path.repo: /usr/share/opensearch/snapshots
{{- if not .Secure }}
      # The security plugin is off. Keep port 9200 private.
      DISABLE_SECURITY_PLUGIN: "true"
{{- end }}
      DISABLE_INSTALL_DEMO_CONFIG: "true"
      OPENSEARCH_JAVA_OPTS: -Xms${OPENSEARCH_HEAP:?set OPENSEARCH_HEAP in .env} -Xmx${OPENSEARCH_HEAP:?}
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
{{- if .Secure }}
    secrets:
      - opensearch_app_password
{{- end }}
{{- if or .Secure .Volume .Bind }}
    volumes:
{{- if .Volume }}
      - opensearch-data:/usr/share/opensearch/data
{{- else if .Bind }}
      - {{ mount .DataDir "opensearch" "/usr/share/opensearch/data" }}
{{- end }}
{{- if .Secure }}
      - ./config/opensearch/opensearch.yml:/usr/share/opensearch/config/opensearch.yml:ro
      - ./config/opensearch/internal_users.yml:/usr/share/opensearch/config/opensearch-security/internal_users.yml:ro
      - ./config/opensearch/roles.yml:/usr/share/opensearch/config/opensearch-security/roles.yml:ro
      - ./config/opensearch/roles_mapping.yml:/usr/share/opensearch/config/opensearch-security/roles_mapping.yml:ro
{{- end }}
{{- end }}
{{- if .Config.Has "opensearch" }}
    ports:
      - "${OPENARCH_BIND_IP:?}:9200:9200"
{{- end }}
    healthcheck:
{{- if .Secure }}
      # printf is a shell builtin, so the password never shows in a process list.
      # -S writes the HTTP error to the health log, so 'openarch up' can see a wrong password.
      test: ["CMD-SHELL", "printf 'user = \"{{ .OpenSearchAppUser }}:%s\"\\n' \"$$(cat /run/secrets/opensearch_app_password)\" | curl -fsS -K - 'http://localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s'"]
{{- else }}
      test: ["CMD-SHELL", "curl -fsS 'http://localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s'"]
{{- end }}
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 60s
{{- if .Bind }}

  # Gives the data folders to the users the containers run as:
  # OpenSearch uid 1000, OpenArch uid 33010. MongoDB fixes its own folder.
  data-init:
    image: {{ .Images.MongoDB }}
    user: root
    restart: "no"
    command:
      - /bin/sh
      - -c
      - |-
        find /data/opensearch ! -user 1000 -exec chown 1000:1000 {} + &&
        find /data/openarch ! -user 33010 -exec chown 33010:1000 {} +
    volumes:
      - {{ mount .DataDir "opensearch" "/data/opensearch" }}
      - {{ mount .DataDir "openarch" "/data/openarch" }}
{{- end }}
{{- if .Config.Has "dashboards" }}

  opensearch-dashboards:
    image: {{ .Images.Dashboards }}
    restart: unless-stopped
    labels:
      openarch.config-hash: ${OPENARCH_DASHBOARDS_CONFIG_HASH:-}
    depends_on:
      opensearch:
        condition: service_healthy
{{- if .Secure }}
    entrypoint:
      - /bin/bash
      - -c
      - |-
        OPENSEARCH_PASSWORD="$$(cat /run/secrets/opensearch_dashboards_password)" || exit 1
        export OPENSEARCH_PASSWORD
        exec ./opensearch-dashboards-docker-entrypoint.sh opensearch-dashboards
    environment:
      OPENSEARCH_HOSTS: '["http://opensearch:9200"]'
      OPENSEARCH_USERNAME: {{ .DashboardsUser }}
    secrets:
      - opensearch_dashboards_password
{{- else }}
    environment:
      OPENSEARCH_HOSTS: '["http://opensearch:9200"]'
      DISABLE_SECURITY_DASHBOARDS_PLUGIN: "true"
{{- end }}
    ports:
      - "${OPENARCH_BIND_IP:?}:5601:5601"
{{- end }}
{{- if .Config.TLSEnabled }}

  # HTTPS entrypoint. OpenArch itself is not published on the host.
  proxy:
    image: {{ .Images.Caddy }}
    restart: unless-stopped
    labels:
      openarch.config-hash: ${OPENARCH_PROXY_CONFIG_HASH:-}
    depends_on:
      - openarch-app
    ports:
      - "${OPENARCH_BIND_IP:?}:${OPENARCH_PORT:?}:443"
    volumes:
      - ./config/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ mount .CertFile "" "/certs/cert.pem:ro" }}
      - {{ mount .KeyFile "" "/certs/key.pem:ro" }}
{{- end }}
{{- if .Secure }}

# Secret values come from .env.local. Compose copies them into the containers.
secrets:
  mongodb_root_password:
    environment: MONGODB_ROOT_PASSWORD
  mongodb_app_password:
    environment: MONGODB_APP_PASSWORD
  mongodb_app_uri:
    environment: MONGODB_APP_URI
  opensearch_app_password:
    environment: OPENSEARCH_APP_PASSWORD
{{- if .Config.Has "dashboards" }}
  opensearch_dashboards_password:
    environment: OPENSEARCH_DASHBOARDS_PASSWORD
{{- end }}
{{- end }}
{{- if .Volume }}

volumes:
  mongodb-data:
  opensearch-data:
  openarch-data:
{{- end }}
