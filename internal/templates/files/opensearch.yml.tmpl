# Generated by openarch from openarch.yaml. Do not edit this file:
# change openarch.yaml and run 'openarch render' instead.
cluster.name: {{ .Config.Name }}
network.host: 0.0.0.0

# TLS between nodes, with a certificate created inside the container at each start.
plugins.security.ssl.transport.keystore_type: PKCS12
plugins.security.ssl.transport.keystore_filepath: transport/node.p12
plugins.security.ssl.transport.keystore_password: ${TRANSPORT_STORE_PASSWORD}
plugins.security.ssl.transport.truststore_type: PKCS12
plugins.security.ssl.transport.truststore_filepath: transport/trust.p12
plugins.security.ssl.transport.truststore_password: ${TRANSPORT_STORE_PASSWORD}
plugins.security.ssl.transport.enforce_hostname_verification: false
plugins.security.nodes_dn:
  - "CN=opensearch-node"

# HTTP on port 9200 stays plain inside the Docker network. It still needs a user and password.
plugins.security.ssl.http.enabled: false

# Users and roles come from the files in opensearch-security/ when the data is created.
plugins.security.allow_default_init_securityindex: true
plugins.security.restapi.roles_enabled: ["all_access"]
plugins.security.system_indices.enabled: true
